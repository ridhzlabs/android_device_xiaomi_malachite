<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for Lunaris AOSP 16.2 on malachite. Copy to
     .repo/local_manifests/lunaris.xml after

       repo init -u https://github.com/Lunaris-AOSP/android -b 16.2 --git-lfs

     Lunaris provides its own frameworks/base, frameworks/native,
     packages/apps/Settings, packages/services/Telephony,
     packages/modules/Bluetooth and external/wpa_supplicant_8, so those
     projects are not overridden here. The malachite changes on top of
     LineageOS for them are cherry-picked onto the Lunaris forks with
     tools/apply-malachite-patches.sh.

     The remaining projects are the last malachite-project lineage-23.2
     state, kept at FMIUI (vendor, kernel, hardware/mediatek, sepolicy,
     dolby), cmdr-chara (vendor/mediatek/ims, wpa_supplicant_8) and
     nanerb25 (hardware/xiaomi). ParanoidSense is PixelOS' unmodified
     sixteen-qpr2 app, as in the malachite-project manifest.
-->
<manifest>
  <remote name="ridhzlabs" fetch="https://github.com/ridhzlabs/" />
  <remote name="malachite-fmiui" fetch="https://github.com/FMIUI/" />
  <remote name="malachite-chara" fetch="https://github.com/cmdr-chara/" />
  <remote name="malachite-nanerb" fetch="https://github.com/nanerb25/" />
  <remote name="pixelos" fetch="https://github.com/PixelOS-AOSP/" />

  <!-- Device -->
  <remove-project path="device/xiaomi/malachite" optional="true" />
  <project path="device/xiaomi/malachite" name="android_device_xiaomi_malachite"
           remote="ridhzlabs" revision="lunaris-16.2" />
  <remove-project path="device/xiaomi/malachite-kernel" optional="true" />
  <project path="device/xiaomi/malachite-kernel" name="android_device_xiaomi_malachite-kernel"
           remote="malachite-fmiui" revision="lineage-23.2" />
  <remove-project path="vendor/xiaomi/malachite" optional="true" />
  <project path="vendor/xiaomi/malachite" name="proprietary_vendor_xiaomi_malachite"
           remote="malachite-fmiui" revision="lineage-23.2" />

  <!-- Platform -->
  <remove-project path="hardware/mediatek" optional="true" />
  <project path="hardware/mediatek" name="android_hardware_mediatek"
           remote="malachite-fmiui" revision="lineage-23.2" />
  <remove-project path="hardware/xiaomi" optional="true" />
  <project path="hardware/xiaomi" name="android_hardware_xiaomi"
           remote="malachite-nanerb" revision="lineage-23.2" />
  <remove-project path="device/mediatek/sepolicy_vndr" optional="true" />
  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr"
           remote="malachite-fmiui" revision="lineage-23.2" />
  <remove-project path="vendor/mediatek/ims" optional="true" />
  <project path="vendor/mediatek/ims" name="android_vendor_mediatek_ims"
           remote="malachite-chara" revision="lineage-23.2" />

  <!-- Overrides of LineageOS projects -->
  <remove-project path="external/wpa_supplicant_8" optional="true" />
  <project path="external/wpa_supplicant_8" name="android_external_wpa_supplicant_8"
           remote="malachite-chara" revision="lineage-23.2" />

  <!-- Additions -->
  <project path="packages/apps/ParanoidSense" name="android_packages_apps_ParanoidSense"
           remote="pixelos" revision="sixteen-qpr2" />
  <project path="hardware/dolby" name="android_hardware_dolby"
           remote="malachite-fmiui" revision="lineage-23.2" />
</manifest>
