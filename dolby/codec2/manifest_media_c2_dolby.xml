<manifest version="1.0" type="device">
    <!-- default1: Dolby audio, default2: Dolby Vision. Both instance names are
         labeled hal_codec2_service in the platform's service_contexts.
         The service registers the AIDL or the HIDL instance, following
         media.c2.hal.selection. -->
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IComponentStore</name>
            <instance>default1</instance>
            <instance>default2</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>android.hardware.media.c2</name>
        <version>1</version>
        <fqname>IComponentStore/default1</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.media.c2</name>
        <version>1</version>
        <fqname>IComponentStore/default2</fqname>
    </hal>
</manifest>
